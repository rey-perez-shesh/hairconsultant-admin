rules_version = '2';

// Firestore security rules for HairConsultant (Android app + admin dashboard).
// Deploy from this folder: `firebase deploy --only firestore:rules`.
//
// Collections:
//  - users          profile per signed-in user (doc id = uid). "disabled" is written only by the
//                   admin Cloud Functions, so the app may never set or change it.
//  - consultations  scan/upload history + favorites; each doc carries the owning userId.
//  - feedback       star ratings + reviews; each doc carries the owning userId.
//  - chatMessages   AI-chatbot history; owner-only (admins see aggregates, never transcripts).
//  - haircuts       the catalog. Everyone signed in reads it; only admins (custom claim
//                   `admin: true`, granted by the setAdminRole function) write it.
//  - auditLogs      append-only record of admin actions.
//  - stats, statsDaily  counters maintained by Cloud Functions; admin read-only.
//  - config         admin-only settings (e.g. the admin list).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    function ownsExisting() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function createsOwn() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function keepsOwner() {
      return request.resource.data.userId == resource.data.userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && !('disabled' in request.resource.data);
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['disabled']);
      allow delete: if isOwner(userId);
    }

    match /consultations/{consultationId} {
      allow read: if ownsExisting() || isAdmin();
      allow create: if createsOwn();
      allow update: if ownsExisting() && keepsOwner();
      allow delete: if ownsExisting();
    }

    match /feedback/{feedbackId} {
      allow read: if ownsExisting() || isAdmin();
      allow create: if createsOwn();
      allow update: if ownsExisting() && keepsOwner();
      allow delete: if ownsExisting();
    }

    match /chatMessages/{messageId} {
      allow read, delete: if ownsExisting();
      allow create: if createsOwn();
      allow update: if ownsExisting() && keepsOwner();
    }

    function validHaircut(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.description is string && d.description.size() <= 2000
        && d.imageUrl is string
        && d.length in ['SHORT', 'MEDIUM', 'LONG']
        && d.texture in ['STRAIGHT', 'WAVY', 'CURLY']
        && d.genderStyle in ['MASCULINE', 'FEMININE', 'UNISEX']
        && d.treatment in ['NONE', 'REBOND', 'PERM']
        && d.recommendedFaceShapes is list && d.recommendedFaceShapes.size() <= 5
        && d.arType in ['AUTO', 'DEEPAR', 'GLB', 'NONE']
        && d.isActive is bool
        && d.sortOrder is int
        && d.updatedBy == request.auth.uid;
    }

    match /haircuts/{haircutId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validHaircut(request.resource.data);
      allow delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.at == request.time;
    }

    match /stats/{docId} {
      allow read: if isAdmin();
    }

    match /statsDaily/{day} {
      allow read: if isAdmin();
    }

    match /config/{docId} {
      allow read: if isAdmin();
    }

    // Everything else (including rateLimits, written only by Cloud Functions) is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
