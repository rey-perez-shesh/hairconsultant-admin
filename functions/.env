# Deployed with the functions (not secret). Copy values to suit your project.
#
# Region for every function. Firestore triggers must run in your Firestore database's region:
# check Firebase console -> Firestore -> the location shown at the top (e.g. asia-southeast1;
# for the multi-region "nam5" use us-central1, for "eur3" use europe-west1).
FUNCTIONS_REGION=asia-southeast1
#
# The email allowed to claim the very first admin role from the dashboard's setup screen.
# Must belong to a Firebase Auth account with a verified email.
BOOTSTRAP_ADMIN_EMAIL=you@example.com
